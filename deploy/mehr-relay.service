[Unit]
Description=MehrChat experimental encrypted relay
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
User=mehrchat
Group=mehrchat
WorkingDirectory=/opt/mehrchat
ExecStart=/opt/mehrchat/venv/bin/python -m mehrchat.server --data /var/lib/mehrchat --port 8787
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/mehrchat
UMask=0077
LimitNOFILE=1024
LimitCORE=0
LimitFSIZE=2147483648
MemoryHigh=384M
MemoryMax=512M
TasksMax=64
CPUQuota=100%
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
[Install]
WantedBy=multi-user.target
